# Defends the Railway build from npm ERESOLVE (owner-diagnosed, deploy c52511fb):
# package.json pins @libsql/client ^0.17.3 while @langchain/community 0.3.30 wants ^0.14.0.
# The Dockerfile's `npm ci || npm install --legacy-peer-deps` fallback only covers the
# DOCKERFILE builder. If the service ever drifts back to RAILPACK (silent config drift
# observed Aug 18, 2026 — Railpack runs plain `npm install` and ignores the Dockerfile),
# this .npmrc is the only guard. Keep it; it is belt-and-suspenders for both build paths.
legacy-peer-deps=true
